{
  "name": "player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "server": "nodemon --ignore spotify_tokens.json server/index.js",
    "start": "node server/index.js",
    "dev": "vite",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "npx vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "gsap": "^3.14.2",
    "helmet": "^8.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.4.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "string-similarity": "^4.0.4",
    "three": "^0.183.2",
    "tone": "^15.1.22",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.vinylplayer.app",
    "productName": "Vinyl Player",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/Vinyl.png"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
